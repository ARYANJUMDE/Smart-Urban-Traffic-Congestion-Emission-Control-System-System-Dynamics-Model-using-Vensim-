{UTF-8}
Conservation Factor=1/Scarcity Index
	~	
	~		|

Evaporation Loss=0.02*Water Reservoir
	~	
	~		|

Ground water level= INTEG (Recharge Rate-Groundwater Extraction,
		3e+09)
	~	
	~		~	:SUPPLEMENTARY 
	|

Groundwater Extraction=0.3*Water Demand
	~	
	~		|

Leakage Rate=0.1
	~	
	~		|

Per Capita Water Use=150
	~	
	~		|

Population Death=0.005*Urban Population
	~	
	~		|

Population Growth=0.015*Urban Population
	~	
	~		|

Rainfall Inflow= ACTIVE INITIAL (Rainfall Rate,
		50000)
	~	
	~		|

Rainfall Rate=100000
	~	
	~		|

Recharge Rate=0.01*Rainfall Inflow
	~	
	~		|

River Inflow=50000
	~	
	~		|

Scarcity Index=1/(Water Reservoir/1e+09)
	~	
	~		|

Urban Population= INTEG (Population Growth-Population Death,
		1e+06)
	~	
	~		|

Water Demand=Urban Population*Per Capita Water Use
	~	
	~		|

Water Extraction=Water Demand*Conservation Factor*(1+Leakage Rate)
	~	
	~		|

Water Reservoir= INTEG (Rainfall Inflow+River Inflow-Evaporation Loss-Water Extraction\
		,
		5e+09)
	~	
	~		|

